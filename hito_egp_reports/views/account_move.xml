<odoo>
  <record id="view_move_form_inherit_dolar_hoy" model="ir.ui.view">
    <field name="name">account.move.form.inherit.dolar.hoy</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='sale_info_group']" position="inside">
        <field name="price_dolar"/>
        <button name="onchange_compute_dolar_price"
                    type="object"
                    string="Actualizar Dólar"
                    class="btn-secondary"/>
      </xpath>

      <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='product_id']" position="after">
          <field name="custom_description" string="Descripción" optional="hide"/>
      </xpath>

    </field>
  </record>
</odoo>