<odoo>
    <template id="hito_stock_report_delivery_aggregated_move_lines_inherit" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//tr/td[1]" position="replace">
            <td>
                <t t-if="'] -' in aggregated_lines[line]['name']">
                    <span><span t-esc="aggregated_lines[line]['name'][:101]"/> <span t-esc="aggregated_lines[line]['description']"/></span>
                </t>
                <t t-else="">
                    <t t-if="aggregated_lines[line]['description']">
                        <span><span t-esc="aggregated_lines[line]['name'][:101]"/> - <span t-esc="aggregated_lines[line]['description']"/></span>
                    </t>
                    <t t-else="">
                        <span t-esc="aggregated_lines[line]['name'][:101]"/>
                    </t>
                </t>
            </td>
        </xpath>

        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="replace">
            <td class="text-center" name="move_line_aggregated_quantity">
                <t t-if="aggregated_lines[line]['quantity']">
                    <span t-esc="aggregated_lines[line]['quantity']" t-options="{'widget': 'integer', 'decimal_precision': 'Product Unit of Measure'}"/>
                    <span t-esc="aggregated_lines[line]['product_uom'].name"/>
                    <span t-if="aggregated_lines[line]['packaging'].name">
                        (<span t-out="aggregated_lines[line]['packaging_quantity']" t-options="{&quot;widget&quot;: &quot;integer&quot;}"/> <span t-out="aggregated_lines[line]['packaging'].name"/>)
                    </span>
                </t>
            </td>
        </xpath>

    </template>
</odoo>